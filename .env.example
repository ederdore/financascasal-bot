# FinançasCasal Backend — variáveis de ambiente
# Copie para .env e preencha os valores
# Na Vercel: Settings → Environment Variables

# Supabase
SUPABASE_URL=https://seuproject.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...  # opcional, para operações admin

# IA
GROQ_API_KEY=gsk_...          # obrigatório — plano free/trial
ANTHROPIC_API_KEY=sk-ant-...  # opcional — plano premium

# Telegram
TELEGRAM_TOKEN=...            # token do @BotFather

# Stripe
STRIPE_SECRET_KEY=sk_test_...    # obrigatório para cobrança
STRIPE_WEBHOOK_SECRET=whsec_...  # webhook do Stripe
STRIPE_PRICE_ID=price_...        # ID do plano Premium R$24

# WhatsApp (futuro)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Push notifications (futuro)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Config
ALLOWED_ORIGIN=https://financascasal-web.vercel.app
APP_URL=https://financascasal-web.vercel.app
